{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/Onboarding",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/OnBordingPage.html",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/F_END",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/F_END/index.html",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/Pages",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    },
    {
      "source": "/Pages/index.html",
      "destination": "/F_END/Pages/OnboardingPage.html",
      "permanent": false
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{B_END/*.js,B_END/models/*.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_path=$1"
    }
  ]
}
