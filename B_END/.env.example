# Daham Pasala Server Configuration
PORT=5001

# Database Provider: firebase (default) | mongodb
DB_PROVIDER=firebase

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-web-app-id

# Firebase Admin Service Account Key (place serviceAccountKey.json in B_END/ or set path/JSON)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional Local Emulator Hosts for Offline Development
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Legacy MongoDB Fallback URI (only used when DB_PROVIDER=mongodb)
MONGODB_URI=mongodb://127.0.0.1:27017/daham_pasala
